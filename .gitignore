.vercel
.env*
# root template only — deeper .env.example files have held real values, keep them ignored
!/.env.example
node_modules
.DS_Store
research/data/
research/.env

# licensed vendor data samples (never commit)
research/private-data/
private-data/

# Claude Code local settings (personal, not committed)
.claude/settings.local.json
.claude/worktrees/

# local analysis scratch (mover/detection back-tests)
scratch-*

# LLM golden-set eval: live results are local; only blessed baselines are committed
research/llm-evals/results/*.latest.json

# agent working dir (local, not committed)
.agents/

# CFR optional python sidecar venv (large, machine-local; recreate from
# tools/forecast-sidecar/requirements-optional.txt)
tools/forecast-sidecar/.venv/

# per-chain result files written by scripts/run-nightly-chain.js (GitHub Actions only)
.nightly/

# research-side Python venv (recreate from research/requirements-*.txt; never commit)
research/.venv/
