{
  "name": "market-news-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "find api lib public/js scripts -name '*.js' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 -P8 node --check && node --check research/lib/outcome-v3.js && node --check research/15-panel-features-v3.js && node --check research/16-secmaster-v3.js",
    "gen:source": "node scripts/gen-full-source.js",
    "fmp:audit": "node --env-file-if-exists=.env.local scripts/fmp-audit.js",
    "probe:nasdaq": "node --env-file-if-exists=.env.local scripts/probe-nasdaq-data-link.js",
    "audit:estimates": "node --env-file-if-exists=.env.local scripts/audit-estimates-sample.js",
    "audit:research": "node scripts/audit-research-data.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@vercel/blob": "^2.4.0",
    "web-push": "^3.6.7"
  }
}
