# Local research env template — copy to .env.local (git-ignored) and fill in.
# .env.local is loaded by `npm run probe:nasdaq` / `npm run fmp:audit` via
# node --env-file-if-exists.
# Financial Modeling Prep key (server-side only; in production it lives in the
# Vercel env). Needed locally only for `npm run fmp:audit`.
FMP_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
# Exact analyst-estimates datatable code from your Nasdaq Data Link subscription
# docs/product page (e.g. VENDOR/TABLE). Leave blank until known — do NOT guess.
NASDAQ_ESTIMATES_TABLE_CODE=

# ── Catalyst–Flow Ranker (research/shadow — safe defaults, app runs fine with all absent) ──
# Master switch for the serving layer reading the prediction artifact. false = surface off.
CATALYST_FLOW_ENABLED=false
# shadow | research. "live" is refused by resolveMode() until every promotion gate is
# recorded PASSED on immutable point-in-time evidence + a manual registry change.
CATALYST_FLOW_MODE=shadow
# Local paths for the offline trainer's model + published daily prediction artifact.
CATALYST_FLOW_MODEL_PATH=
CATALYST_FLOW_PREDICTIONS_PATH=
# Optional licensed feeds — leave blank; absence yields INSUFFICIENT_DATA, never a fake arm.
# Point-in-time estimates provider (none contracted today; FMP estimates are post-release).
CATALYST_PIT_ESTIMATES_URL=
# Cboe Open-Close (signed customer opening flow) licensed file/endpoint, if ever purchased.
CATALYST_CBOE_OPEN_CLOSE_PATH=
