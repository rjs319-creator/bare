# Local research env template — copy to .env.local (git-ignored) and fill in.
# .env.local is loaded by `npm run probe:nasdaq` / `npm run fmp:audit` via
# node --env-file-if-exists.
# Financial Modeling Prep key (server-side only; in production it lives in the
# Vercel env). Needed locally only for `npm run fmp:audit`.
FMP_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
# Exact analyst-estimates datatable code from your Nasdaq Data Link subscription
# docs/product page (e.g. VENDOR/TABLE). Leave blank until known — do NOT guess.
NASDAQ_ESTIMATES_TABLE_CODE=

# ── Catalyst–Flow Ranker (research/shadow — safe defaults, app runs fine with all absent) ──
# Master switch for the serving layer reading the prediction artifact. false = surface off.
CATALYST_FLOW_ENABLED=false
# shadow | research. "live" is refused by resolveMode() until every promotion gate is
# recorded PASSED on immutable point-in-time evidence + a manual registry change.
CATALYST_FLOW_MODE=shadow
# Local paths for the offline trainer's model + published daily prediction artifact.
CATALYST_FLOW_MODEL_PATH=
CATALYST_FLOW_PREDICTIONS_PATH=
# Optional licensed feeds — leave blank; absence yields INSUFFICIENT_DATA, never a fake arm.
# Point-in-time estimates provider (none contracted today; FMP estimates are post-release).
CATALYST_PIT_ESTIMATES_URL=
# Cboe Open-Close (signed customer opening flow) licensed file/endpoint, if ever purchased.
CATALYST_CBOE_OPEN_CLOSE_PATH=

# ── CFR — Cross-Sectional Forecast & Ranking (research/decision-support; all optional) ──
# The whole subsystem runs with every one of these blank: the Ridge/AR baseline, the purged
# walk-forward, the cost-aware backtest and the 0-100 score need no Python and no credentials.
# See docs/FORECAST-RANKING-SYSTEM.md.
#
# Python interpreter for the optional model sidecar. Blank -> tools/forecast-sidecar/.venv, then
# python3 on PATH. Point this at a >=3.10 interpreter to enable Chronos-2 / Moirai-2.
FORECAST_PYTHON=
# Comma-separated base models to enable (default: ridge,chronos2,moirai2). The ridge baseline is
# permanent and is included whatever this says.
FORECAST_MODELS=
# Foundation-model identity. PIN A REVISION before any production use — an unpinned checkpoint
# is not reproducible. chronos-forecasting 1.x is Chronos-1/Bolt and is REFUSED, never substituted.
FORECAST_CHRONOS2=
FORECAST_CHRONOS2_MODEL=
FORECAST_CHRONOS2_REVISION=
FORECAST_MOIRAI2=
FORECAST_MOIRAI2_MODEL=
FORECAST_MOIRAI2_REVISION=
# Meta-ranker backend: lightgbm | ridge-xs (blank = lightgbm when available, ridge-xs otherwise).
FORECAST_META_BACKEND=
# Walk-forward geometry, in DECISION-DATE units on the (possibly strided) study axis.
FORECAST_STRIDE=
FORECAST_MIN_TRAIN_SESSIONS=
FORECAST_TEST_SESSIONS=
FORECAST_INNER_FOLDS=
FORECAST_HORIZONS=
# Universe limits for a run.
FORECAST_MAX_NAMES=
FORECAST_MIN_ADV=
# Serving knobs and artifact locations.
FORECAST_TRAIN_SESSIONS=
FORECAST_ARTIFACT_DIR=
FORECAST_ARTIFACT_PATH=
# Deterministic seed for every stochastic component.
FORECAST_SEED=
# Test-only: 1 makes the foundation adapters return SYNTHETIC fixture forecasts (stamped as such).
FORECAST_FIXTURE_MODE=
